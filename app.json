    "plugins": [["expo-image-picker", { "photosPermission": "Cho phép Memento chọn ảnh hồ sơ và ảnh chụp.", "cameraPermission": "Cho phép Memento chụp ảnh hồ sơ.", "microphonePermission": false }]]
  }
}
