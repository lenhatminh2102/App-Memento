{
  "name": "memento-mobile",
  "version": "2.0.2",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --go",
    "start:dev": "expo start --dev-client",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "check": "tsc --noEmit",
    "test": "node --test scripts/*.test.cjs",
    "bundle:android": "expo export --platform android",
    "apk": "node scripts/build-apk.cjs",
    "test:auth": "node scripts/check-auth.cjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.16",
